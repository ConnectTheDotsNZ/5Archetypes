// Five Archetypes Platform — data model v1
// See docs/BUILD_PLAN.md Section 3.1 and 7.1 for the reasoning behind these entities.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  US
  EU
}

enum AssessmentSource {
  CSV_UPLOAD
  MANUAL_ENTRY
  CONNECTOR // future: native assessment delivery / external test connector
}

enum ReportKind {
  INDIVIDUAL_PROFILE
  PAIRWISE_WORKPLACE
}

enum MemberNotificationKind {
  SCORES_RECEIVED // "your assessment scores have been recorded"
  REPORT_READY // "here is your Individual Archetype Profile"
}

enum MemberNotificationStatus {
  PENDING
  // Claimed by a drain pass and handed to the email provider. A row stuck
  // here means the process died mid-send; it is deliberately not retried
  // automatically, since we can't tell whether the message went out.
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum OrgRole {
  ADMIN
  MANAGER
}

// Distinct from OrgRole (a legacy, user-level attribute — see User.role) even
// though the values are identical today: this is a property of one
// user-organization pairing, not of the user account itself. A consultant or
// Carey can be ADMIN in one org and hold no role at all in another.
enum MembershipRole {
  ADMIN
  MANAGER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  region    Region   @default(US)
  createdAt DateTime @default(now())

  users  User[]
  teams  Team[]
  reports GeneratedReport[]
  memberNotifications MemberNotification[]
  memberships OrganizationMembership[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  // Auth0's stable subject identifier for this user. Nullable so a MANAGER
  // can be pre-provisioned by email (invited) before their first login.
  auth0Sub       String?      @unique
  // Legacy: a user's original/home org. Kept as the fallback "current org"
  // for anyone with exactly one OrganizationMembership row (the common case),
  // and as the org a brand-new signup's first row is created in. Do not use
  // this to check "which orgs can this user access" — that's `memberships`.
  role           OrgRole      @default(ADMIN)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // ConnectTheDots staff / Carey: implicit access to every organization,
  // including ones created after this flag is set. Never settable from any
  // app UI — toggled directly in the database for a small, named set of
  // accounts. Prefer an explicit OrganizationMembership row for anyone whose
  // access should be limited to specific orgs (consultants, coaches).
  isPlatformSuperuser Boolean @default(false)
  createdAt      DateTime     @default(now())

  requestedNotifications MemberNotification[]
  memberships    OrganizationMembership[]
  invitedMemberships OrganizationMembership[] @relation("MembershipInvitedBy")
  accessAudits   OrgAccessAudit[]
}

// One row per org a user can access, with the role they hold in that org.
// Source of truth for "which orgs can this identity act on" once a user has
// more than one; see src/lib/auth.ts for how `User.organizationId`/`role`
// (single-org legacy fields) and this table reconcile.
model OrganizationMembership {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  role           MembershipRole @default(ADMIN)
  createdAt      DateTime       @default(now())
  invitedById    String?
  invitedBy      User?          @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([userId, organizationId])
}

// Written only when a platform-superuser's access to an org isn't backed by
// an explicit OrganizationMembership row — i.e. the one access pattern with
// no per-row business justification, on HR/people data. Routine same-org
// membership access is not logged here.
model OrgAccessAudit {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  path           String?
  createdAt      DateTime     @default(now())
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        Member[]
  createdAt      DateTime     @default(now())
}

model Member {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id])
  name        String
  roleTitle   String?
  email       String?
  assessments Assessment[]
  createdAt   DateTime     @default(now())

  // Set by an org ADMIN, not by the member: whether this person should be
  // emailed their own report once one exists. Consulted at report-generation
  // time (Phase 1 Steps 5-6) rather than acted on here. Requires `email`.
  sendReportsToMember Boolean @default(false)

  notifications MemberNotification[]
}

// Outbox of member-facing emails an admin has asked for. Rows are created
// PENDING and nothing drains them yet: there is no email provider wired up
// and no report to attach (docs/BUILD_PLAN.md Steps 5-6). Recording the
// request — with who asked and the address at the time — keeps the decision
// auditable, which matters for a report about someone's own profile.
model MemberNotification {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  memberId       String
  member         Member                   @relation(fields: [memberId], references: [id])
  // The ingestion that prompted it, where there was one.
  assessmentId   String?
  assessment     Assessment?              @relation(fields: [assessmentId], references: [id])
  kind           MemberNotificationKind
  status         MemberNotificationStatus @default(PENDING)
  // Captured at request time: the member's address may change or be cleared later.
  emailAtRequest String
  requestedById  String?
  requestedBy    User?                    @relation(fields: [requestedById], references: [id])
  createdAt      DateTime                 @default(now())
  sentAt         DateTime?
  failureReason  String?
}

// Five decimal scores (0-1), one per element. The exact scoring algorithm
// that turns raw assessment answers into these decimals is NOT yet
// documented — see docs/BUILD_PLAN.md Section 9, item 2. Until Carey
// confirms it, `wood..water` are treated as an already-computed input
// (from CSV/manual entry), not derived on our side from raw item scores.
model Assessment {
  id        String           @id @default(cuid())
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id])
  source    AssessmentSource
  wood      Float
  fire      Float
  earth     Float
  metal     Float
  water     Float
  takenAt   DateTime         @default(now())
  rawImportRef String?       // e.g. original CSV filename/row, for audit/reprocessing
  createdAt DateTime         @default(now())

  notifications MemberNotification[]
}

model GeneratedReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           ReportKind
  memberAId      String
  memberBId      String?      // null for INDIVIDUAL_PROFILE
  contentJson    Json         // structured content assembled by the template engine
  pdfPath        String?      // set once a PDF has been rendered
  createdAt      DateTime     @default(now())
}
