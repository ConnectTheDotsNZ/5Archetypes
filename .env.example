# Neon Postgres connection string (see https://neon.tech). src/lib/prisma.ts and
# prisma/seed.ts connect via the Neon serverless driver + Prisma driver adapter
# (driverAdapters preview feature), which tunnels the Postgres wire protocol
# over WebSocket/HTTPS instead of a raw TCP connection.
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth0 (Regular Web App) — see src/lib/auth0.ts and src/lib/auth.ts. Register
# http://localhost:3000/api/auth/callback as an Allowed Callback URL, and
# http://localhost:3000 as an Allowed Logout URL and Web Origin, on the Auth0
# application. AUTH0_SECRET must be a 32-byte hex string (`openssl rand -hex 32`).
AUTH0_SECRET=
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER_BASE_URL="https://YOUR_TENANT.us.auth0.com"
