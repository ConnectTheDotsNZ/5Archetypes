# Neon Postgres connection string (see https://neon.tech). src/lib/prisma.ts and
# prisma/seed.ts connect via the Neon serverless driver + Prisma driver adapter
# (driverAdapters preview feature), which tunnels the Postgres wire protocol
# over WebSocket/HTTPS instead of a raw TCP connection.
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth0 (Regular Web App) — see src/lib/auth0.ts and src/lib/auth.ts. Register
# http://localhost:3000/api/auth/callback as an Allowed Callback URL, and
# http://localhost:3000 as an Allowed Logout URL and Web Origin, on the Auth0
# application. AUTH0_SECRET must be a 32-byte hex string (`openssl rand -hex 32`).
AUTH0_SECRET=
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER_BASE_URL="https://YOUR_TENANT.us.auth0.com"

# Member-facing email (src/lib/email/provider.ts). Drives the
# MemberNotification outbox an admin fills in when saving scores.
#
# EMAIL_PROVIDER unset  -> nothing is sent; queued notifications stay PENDING
#                          and the admin UI says email isn't configured.
# EMAIL_PROVIDER=console-> messages are written to the server log (local dev).
# EMAIL_PROVIDER=gmail  -> SMTP via Google Workspace (connectthedots.co.nz for
#                          testing; swap for a bespoke sending domain and a
#                          transactional provider before go-live).
#
# Gmail needs an App Password, NOT the account password: enable 2-Step
# Verification on the account, then create one under Google Account ->
# Security -> App passwords. Workspace SMTP also caps daily recipients, which
# is fine for pilot teams but another reason to move providers before
# self-serve signup.
EMAIL_PROVIDER=
GMAIL_USER="noreply@connectthedots.co.nz"
GMAIL_APP_PASSWORD=
# Envelope From, e.g. Five Archetypes <noreply@connectthedots.co.nz>.
# Must be an address the GMAIL_USER account is allowed to send as.
EMAIL_FROM="Five Archetypes <noreply@connectthedots.co.nz>"
# Optional: where member replies should land.
EMAIL_REPLY_TO=
